# Cloud storage provider: local | hybrid | cos | r2 | qiniu | false
STORAGE_PROVIDER=false

# --- Cloudflare R2 (global) ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

# --- Qiniu / 七牛云 (China) ---
QINIU_ENDPOINT=https://s3-cn-east-1.qiniucs.com
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_REGION=cn-east-1
# Optional CDN domain/endpoint. Required only for CDN traffic status or redirect-mode CDN downloads.
QINIU_CDN_DOMAIN=
QINIU_CDN_ENDPOINT=
# Qiniu free tier limit (default 10GB = 10737418240 bytes)
QINIU_MAX_BYTES=10737418240

# --- Tencent Cloud COS / 腾讯云对象存储 ---
# Use cos to store all encrypted objects in COS.
# Use hybrid to store small encrypted objects on this server and large objects in COS.
COS_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai

# --- Common storage settings ---
# Files smaller than this are served from the original shared file instead of object cache
STORAGE_FALLBACK_BYTES=1048576
# local/hybrid encrypted object cache directory. Defaults to DATA_DIR/object-cache
STORAGE_LOCAL_DIR=
# local encrypted object cache soft cap. Default 10GB for local/hybrid
STORAGE_LOCAL_MAX_BYTES=10737418240
# hybrid: files at or above this size are encrypted and uploaded to COS
STORAGE_REMOTE_THRESHOLD_BYTES=67108864
# optional remote encrypted object soft cap. 0 disables remote cap
STORAGE_REMOTE_MAX_BYTES=0
# redirect keeps old presigned URL behavior; proxy makes syncd stream encrypted objects itself
STORAGE_DOWNLOAD_MODE=proxy
# chunked AEAD plaintext chunk size. Keep browser/Python parser format-compatible.
STORAGE_AEAD_CHUNK_BYTES=1048576
# remote multipart upload part size. COS/S3 multipart minimum is 5MB.
STORAGE_REMOTE_PART_BYTES=8388608
# remote S3/COS request timeout
STORAGE_REQUEST_TIMEOUT_MS=120000
# Presigned URL expiry time in seconds
STORAGE_PRESIGN_EXPIRY_SECONDS=3600
# Hot data duration: how long since last access before deletion (default 72h)
STORAGE_HOT_DURATION_MS=259200000
# Max total storage bytes (default 5GB - use 50% of 10GB free tier)
STORAGE_MAX_BYTES=5368709120
# Cleanup check interval (default 1h)
STORAGE_CLEANUP_INTERVAL_MS=3600000

# Extra browser CSP connect-src sources, space separated.
# Keep empty for local/proxy downloads. Add explicit object-storage origins only if STORAGE_DOWNLOAD_MODE=redirect.
CSP_CONNECT_SRC=
# Browser download policy: keep the UI on the current origin, but send larger downloads to this relay first.
CLIENT_PRIMARY_RELAY_URL=
# Optional comma/space separated fallbacks, tried in order after CLIENT_PRIMARY_RELAY_URL.
# HTTP fallbacks are skipped by browsers on HTTPS pages unless this is explicitly true.
CLIENT_RELAY_BASE_URLS=
CLIENT_ALLOW_INSECURE_RELAY_FALLBACK=false
CLIENT_CF_INLINE_MAX_BYTES=204800
# Shared secret used to derive encrypted relay credentials for paired clients.
# It is delivered through /api/transport-config as AES-GCM ciphertext, then used for per-request HMAC headers.
CLIENT_RELAY_ACCESS_KEY=

# --- Relay server settings ---
# Must match CLIENT_RELAY_ACCESS_KEY on the origin when browser/Python clients use the relay.
RELAY_ACCESS_KEY=
# Keep false for syncd relay deployments; the browser/CLI use encrypted delivery plus HMAC headers instead.
RELAY_ACCESS_FORM_ENABLED=false
# Keep false for public relay; true only during old-client migration because it accepts the raw key header.
RELAY_ACCEPT_LEGACY_ACCESS_KEY=false
# Default false keeps local HTTP deployments usable. Set true only when every public access path is TLS.
RELAY_REQUIRE_HTTPS=false
# auto adds Secure cookies when nginx/proxy sends X-Forwarded-Proto: https, but keeps local HTTP usable.
RELAY_ACCESS_COOKIE_SECURE=auto
# Origins allowed to call relay from a browser. "*" is acceptable when the relay access key is still required.
RELAY_CORS_ORIGINS=*

# --- Relay agent / client examples ---
# RELAY_URL=https://your-relay.example.com
# RELAY_KEY=change-me-long-random-agent-key
# ORIGIN_URL=http://127.0.0.1:21891
# SYNCD_SERVER=https://your-relay.example.com
# SYNCD_RELAY_ACCESS_KEY=change-me-long-random-client-key

# --- Chunked AEAD settings ---
# Files larger than this will use chunked streaming encryption
CHUNKED_THRESHOLD_BYTES=67108864
